{
  "$meta": {
    "name": "StudyGuard AI Design Tokens",
    "version": "1.0.0",
    "description": "Single source of truth. Exported to CSS, Tailwind, Flutter, and Material."
  },
  "color": {
    "brand": {
      "50": "#EEF0FF", "100": "#E0E3FF", "200": "#C7CCFF", "300": "#A5ADFF",
      "400": "#818CFF", "500": "#6366F1", "600": "#4F46E5", "700": "#4338CA",
      "800": "#3730A3", "900": "#312E81"
    },
    "coach": { "500": "#8B5CF6", "600": "#7C3AED" },
    "growth": { "500": "#10B981", "600": "#059669" },
    "streak": { "500": "#F59E0B", "600": "#D97706" },
    "semantic": {
      "success": "#16A34A", "warning": "#D97706", "danger": "#DC2626", "info": "#2563EB"
    },
    "neutral": {
      "0": "#FFFFFF", "50": "#F7F8FA", "100": "#EEF1F5", "200": "#E2E6EC",
      "300": "#C9D0DA", "400": "#9AA4B2", "500": "#6B7480", "600": "#4B535E",
      "700": "#333A44", "800": "#1E242E", "900": "#141922", "950": "#0B0E14"
    },
    "light": {
      "bg": "#F7F8FA", "surface": "#FFFFFF", "surfaceAlt": "#EEF1F5",
      "text": "#141922", "textMuted": "#4B535E", "border": "#E2E6EC"
    },
    "dark": {
      "bg": "#0B0E14", "surface": "#141922", "surfaceAlt": "#1E242E",
      "text": "#E6EDF3", "textMuted": "#9AA4B2", "border": "#2A313C"
    }
  },
  "typography": {
    "fontFamily": {
      "sans": "Inter, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif",
      "display": "Newsreader, Georgia, serif",
      "mono": "JetBrains Mono, SFMono-Regular, Consolas, monospace"
    },
    "scale": {
      "xs": "12px", "sm": "14px", "base": "16px", "lg": "18px", "xl": "20px",
      "2xl": "24px", "3xl": "30px", "4xl": "36px", "5xl": "48px", "6xl": "60px"
    },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "lineHeight": { "tight": 1.15, "snug": 1.3, "normal": 1.5, "relaxed": 1.7 },
    "letterSpacing": { "tight": "-0.02em", "normal": "0", "wide": "0.06em" }
  },
  "space": { "0": "0", "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px", "6": "24px", "8": "32px", "10": "40px", "12": "48px", "16": "64px", "20": "80px", "24": "96px" },
  "radius": { "xs": "6px", "sm": "10px", "md": "14px", "lg": "20px", "xl": "28px", "pill": "999px" },
  "shadow": {
    "xs": "0 1px 2px rgba(13,18,28,0.06)",
    "sm": "0 2px 6px rgba(13,18,28,0.08)",
    "md": "0 6px 16px rgba(13,18,28,0.10)",
    "lg": "0 14px 34px rgba(13,18,28,0.14)",
    "glow": "0 0 0 4px rgba(99,102,241,0.18)"
  },
  "elevation": { "0": "none", "1": "shadow.xs", "2": "shadow.sm", "3": "shadow.md", "4": "shadow.lg" },
  "glass": {
    "light": { "bg": "rgba(255,255,255,0.65)", "blur": "18px", "border": "rgba(255,255,255,0.5)" },
    "dark": { "bg": "rgba(20,25,34,0.55)", "blur": "18px", "border": "rgba(255,255,255,0.08)" }
  },
  "motion": {
    "duration": { "instant": "80ms", "fast": "140ms", "base": "220ms", "slow": "360ms", "celebrate": "600ms" },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "decelerate": "cubic-bezier(0, 0, 0, 1)",
      "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)"
    }
  },
  "zIndex": { "base": 0, "card": 10, "nav": 100, "overlay": 900, "modal": 1000, "toast": 1100, "command": 1200 },
  "breakpoint": { "sm": "640px", "md": "768px", "lg": "1024px", "xl": "1280px", "2xl": "1536px" }
}
